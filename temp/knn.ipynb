    "    json.dump(scores , fp, indent = 4) \n",
    "\n",
    "\n",
    "model = src.tfidf_svd50_log.Tfidf()\n",
    "scores = knn_acc_svd(model)\n",
    "with open(f\"text_embedding/MTEB/knn_results/{model.mteb_model_meta.name}_{model.mteb_model_meta.revision}.json\", \"w\") as fp:\n",
    "    json.dump(scores , fp, indent = 4) \n",
    "\n",
